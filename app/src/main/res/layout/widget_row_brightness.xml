<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:tools="http://schemas.android.com/tools"
              tools:ignore="UseAppTint,HardcodedText"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:gravity="center_vertical"
              android:orientation="horizontal">

    <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_sun"
            android:tint="@color/muted"
            android:importantForAccessibility="no"/>

    <ImageView
            android:id="@+id/w_bright_minus"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:padding="9dp"
            android:background="@drawable/widget_step_bg"
            android:src="@drawable/ic_minus"
            android:tint="@color/text"
            android:contentDescription="@string/bright_less"/>

    <ProgressBar
            android:id="@+id/w_bright_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_weight="1"
            android:minHeight="5dp"
            android:maxHeight="5dp"
            android:max="100"
            android:progress="50"
            android:progressDrawable="@drawable/widget_progress"/>

    <ImageView
            android:id="@+id/w_bright_plus"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="9dp"
            android:background="@drawable/widget_step_bg"
            android:src="@drawable/ic_plus"
            android:tint="@color/text"
            android:contentDescription="@string/bright_more"/>

    <TextView
            android:id="@+id/w_bright_value"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="1"
            android:text="50%"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text"/>
</LinearLayout>
