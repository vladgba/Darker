<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:tools="http://schemas.android.com/tools"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/ink"
            android:fillViewport="true"
            android:fitsSystemWindows="true">

<LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:text="@string/app_name"
            android:textAllCaps="true"
            android:letterSpacing="0.45"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text"/>

    <!-- Controls: centered in whatever space the setup buttons leave -->
    <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="480dp">

        <LinearLayout
                android:layout_width="320dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical">

            <ImageButton
                    android:id="@+id/power"
                    android:layout_width="168dp"
                    android:layout_height="168dp"
                    android:background="@drawable/power_button"
                    android:src="@drawable/ic_power"
                    android:scaleType="centerInside"
                    android:padding="58dp"
                    android:stateListAnimator="@null"
                    android:tint="@color/power_icon"
                    android:contentDescription="@string/turn_on"/>

            <TextView
                    android:id="@+id/state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/state_off"
                    android:textAllCaps="true"
                    android:letterSpacing="0.35"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/muted"/>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                <TextView
                        android:id="@+id/dim_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dim"
                        android:textAllCaps="true"
                        android:letterSpacing="0.25"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/muted"/>

                <TextView
                        android:id="@+id/dim_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light"
                        android:textSize="28sp"
                        android:textColor="@color/text"
                        android:includeFontPadding="false"
                        tools:text="50%"/>
            </LinearLayout>

            <SeekBar
                    android:id="@+id/dim_slider"
                    style="@style/DarkerSlider"
                    android:min="0"
                    android:max="80"/>
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                <TextView
                        android:id="@+id/bright_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/brightness"
                        android:textAllCaps="true"
                        android:letterSpacing="0.25"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/muted"/>

                <TextView
                        android:id="@+id/bright_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light"
                        android:textSize="28sp"
                        android:textColor="@color/text"
                        android:includeFontPadding="false"
                        tools:text="50%"/>
            </LinearLayout>

            <SeekBar
                    android:id="@+id/bright_slider"
                    style="@style/DarkerSlider"
                    android:min="1"
                    android:max="100"/>
        </LinearLayout>
    </FrameLayout>

    <!-- Setup: one row per permission still missing; the whole block hides when all are granted -->
    <LinearLayout
            android:id="@+id/setup_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

        <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="4dp"
                android:background="@color/line"/>

        <LinearLayout
                android:id="@+id/row_overlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

            <FrameLayout
                    android:id="@+id/btn_overlay"
                    style="@style/DarkerButton"
                    android:background="@drawable/button_filled">

                <TextView
                        style="@style/DarkerButtonLabel"
                        android:text="@string/allow_overlay"
                        android:textColor="@color/ink"
                        android:drawableStart="@drawable/ic_layers"
                        android:drawableTint="@color/ink"/>
            </FrameLayout>

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/allow_overlay_hint"
                    android:textSize="12sp"
                    android:textColor="@color/muted"/>
        </LinearLayout>
        <LinearLayout
                android:id="@+id/row_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

            <FrameLayout
                    android:id="@+id/btn_settings"
                    style="@style/DarkerButton"
                    android:background="@drawable/button_outlined">

                <TextView
                        style="@style/DarkerButtonLabel"
                        android:text="@string/allow_settings"
                        android:textColor="@color/text"
                        android:drawableStart="@drawable/ic_sun"
                        android:drawableTint="@color/text"/>
            </FrameLayout>

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/allow_settings_hint"
                    android:textSize="12sp"
                    android:textColor="@color/muted"/>
        </LinearLayout>
        <LinearLayout
                android:id="@+id/row_a11y"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

            <FrameLayout
                    android:id="@+id/btn_a11y"
                    style="@style/DarkerButton"
                    android:background="@drawable/button_outlined">

                <TextView
                        style="@style/DarkerButtonLabel"
                        android:text="@string/enable_a11y"
                        android:textColor="@color/text"
                        android:drawableStart="@drawable/ic_accessibility"
                        android:drawableTint="@color/text"/>
            </FrameLayout>

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/enable_a11y_hint"
                    android:textSize="12sp"
                    android:textColor="@color/muted"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
</ScrollView>
