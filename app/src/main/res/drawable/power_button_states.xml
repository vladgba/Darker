<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android"
          android:enterFadeDuration="220"
          android:exitFadeDuration="220">
    <item android:state_activated="true">
        <layer-list>
            <!-- soft halo + solid disc -->
            <item>
                <shape android:shape="oval"><solid android:color="#26F2EDE4"/></shape>
            </item>
            <item android:top="10dp" android:bottom="10dp" android:left="10dp" android:right="10dp">
                <shape android:shape="oval"><solid android:color="@color/accent"/></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="10dp" android:bottom="10dp" android:left="10dp" android:right="10dp">
                <shape android:shape="oval">
                    <solid android:color="@color/surface"/>
                    <stroke android:width="2dp" android:color="@color/ring"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
